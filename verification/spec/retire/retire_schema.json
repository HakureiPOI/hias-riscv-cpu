{
  "schema": "hias-retire/2",
  "description": "Field contract for P0-02-R1. Reference records must use null plus not_observed_fields; DUT records must provide required hardware observations. Synthetic records are format-only.",
  "sources": ["dut", "spike-derived", "synthetic"],
  "normal_required": [
    "schema", "kind", "source", "seq", "token", "token_valid",
    "pc", "instr", "next_pc", "next_pc_valid", "priv",
    "rd_we", "rd", "rd_data",
    "csr_valid", "csr_rd_valid", "csr_wr_valid", "csr_addr", "csr_wdata", "csr_rdata",
    "mem_valid", "mem_we", "mem_va", "mem_pa", "mem_size", "mem_mask",
    "mem_wdata", "mem_rdata", "derived_fields", "not_observed_fields"
  ],
  "trap_required": [
    "schema", "kind", "source", "seq", "pc", "epc", "target_pc",
    "cause", "is_interrupt", "tval", "from_priv", "to_priv",
    "mstatus_before", "mstatus_after", "cause_csr_before", "cause_csr_after",
    "epc_csr_before", "epc_csr_after"
  ],
  "bundle_required": [
    "schema", "kind", "slots", "trap", "seq_base"
  ],
  "normal_fields": {
    "schema": {"type": "string", "const": "hias-retire/2"},
    "kind": {"type": "string", "const": "normal"},
    "source": {"type": "string", "enum": ["dut", "spike-derived", "synthetic"]},
    "seq": {"type": "integer", "min": 0},
    "token": {
      "type": ["object", "null"],
      "properties": {
        "idx": {"type": "integer", "min": 0, "max": 31},
        "gen": {"type": "integer", "min": 0, "max": 255}
      }
    },
    "token_valid": {"type": "boolean"},
    "pc": {"type": "integer", "min": 0, "max": 4294967295},
    "instr": {"type": "integer", "min": 0, "max": 4294967295},
    "next_pc": {"type": ["integer", "null"], "min": 0, "max": 4294967295},
    "next_pc_valid": {"type": "boolean"},
    "priv": {"type": "string", "enum": ["U", "S", "M"]},
    "rd_we": {"type": "boolean"},
    "rd": {"type": "integer", "min": 0, "max": 31},
    "rd_data": {"type": ["integer", "null"], "min": 0, "max": 4294967295},
    "csr_valid": {"type": "boolean"},
    "csr_rd_valid": {"type": "boolean"},
    "csr_wr_valid": {"type": "boolean"},
    "csr_addr": {"type": ["integer", "null"], "min": 0, "max": 4095},
    "csr_wdata": {"type": ["integer", "null"], "min": 0, "max": 4294967295},
    "csr_rdata": {"type": ["integer", "null"], "min": 0, "max": 4294967295},
    "mem_valid": {"type": "boolean"},
    "mem_we": {"type": "boolean"},
    "mem_va": {"type": ["integer", "null"], "min": 0, "max": 4294967295},
    "mem_pa": {"type": ["integer", "null"], "min": 0, "max": 17179869183},
    "mem_size": {"type": "string", "enum": ["none", "byte", "half", "word"]},
    "mem_mask": {"type": ["integer", "null"], "min": 0, "max": 15},
    "mem_wdata": {"type": ["integer", "null"], "min": 0, "max": 4294967295},
    "mem_rdata": {"type": ["integer", "null"], "min": 0, "max": 4294967295},
    "derived_fields": {"type": "array", "items": {"type": "string"}},
    "not_observed_fields": {"type": "array", "items": {"type": "string"}}
  },
  "trap_fields": {
    "schema": {"type": "string", "const": "hias-retire/2"},
    "kind": {"type": "string", "const": "trap"},
    "source": {"type": "string", "enum": ["dut", "synthetic"]},
    "seq": {"type": "integer", "min": 0},
    "pc": {"type": "integer", "min": 0, "max": 4294967295},
    "epc": {"type": "integer", "min": 0, "max": 4294967295},
    "target_pc": {"type": "integer", "min": 0, "max": 4294967295},
    "cause": {"type": "integer", "min": 0, "max": 31},
    "is_interrupt": {"type": "boolean"},
    "tval": {"type": "integer", "min": 0, "max": 4294967295},
    "from_priv": {"type": "string", "enum": ["U", "S", "M"]},
    "to_priv": {"type": "string", "enum": ["U", "S", "M"]},
    "mstatus_before": {"type": "integer", "min": 0, "max": 4294967295},
    "mstatus_after": {"type": "integer", "min": 0, "max": 4294967295},
    "cause_csr_before": {"type": "integer", "min": 0, "max": 4294967295},
    "cause_csr_after": {"type": "integer", "min": 0, "max": 4294967295},
    "epc_csr_before": {"type": "integer", "min": 0, "max": 4294967295},
    "epc_csr_after": {"type": "integer", "min": 0, "max": 4294967295}
  },
  "bundle_fields": {
    "schema": {"type": "string", "const": "hias-retire/2"},
    "kind": {"type": "string", "const": "bundle"},
    "slots": {"type": "array", "items": {"type": "object"}},
    "trap": {"type": ["object", "null"]},
    "seq_base": {"type": "integer", "min": 0}
  },
  "rules": {
    "normal_max_slots": 2,
    "slot_valid_values": [0, 1, 3],
    "trap_source": ["dut", "synthetic"],
    "mutual_exclusion": "trap_valid implies no normal slots in the same bundle"
  }
}
