{
  "schema": "hias-retire/1",
  "description": "Machine-checkable field contract for one normal retirement record. Optional observations use explicit valid bits; null/zero must not be used to mean 'not observed'.",
  "required": [
    "schema",
    "kind",
    "seq",
    "token",
    "pc",
    "instr",
    "next_pc",
    "priv",
    "rd_we",
    "rd",
    "rd_data",
    "csr_we",
    "csr_addr",
    "csr_wdata",
    "csr_rdata",
    "mem_valid",
    "mem_we",
    "mem_va",
    "mem_pa",
    "mem_size",
    "mem_mask",
    "mem_wdata",
    "mem_rdata",
    "source"
  ],
  "kind_values": ["normal", "trap"],
  "priv_values": ["U", "S", "M"],
  "mem_size_values": ["none", "byte", "half", "word"],
  "fields": {
    "schema": {"type": "string", "const": "hias-retire/1"},
    "kind": {"type": "string", "enum": ["normal", "trap"]},
    "seq": {"type": "integer", "min": 0, "note": "simulation-only global retirement index"},
    "token": {
      "type": "object",
      "required": ["idx", "gen"],
      "properties": {
        "idx": {"type": "integer", "min": 0, "max": 31},
        "gen": {"type": "integer", "min": 0, "max": 255}
      },
      "note": "ROB index plus generation; index alone is not an identity"
    },
    "pc": {"type": "integer", "min": 0, "max": 4294967295},
    "instr": {"type": "integer", "min": 0, "max": 4294967295},
    "next_pc": {"type": "integer", "min": 0, "max": 4294967295},
    "priv": {"type": "string", "enum": ["U", "S", "M"]},
    "rd_we": {"type": "boolean"},
    "rd": {"type": "integer", "min": 0, "max": 31},
    "rd_data": {"type": ["integer", "null"], "note": "null iff rd_we=false; rd=x0 must have rd_we=false"},
    "csr_we": {"type": "boolean"},
    "csr_addr": {"type": ["integer", "null"], "min": 0, "max": 4095, "note": "null iff csr_we=false"},
    "csr_wdata": {"type": ["integer", "null"], "note": "null iff csr_we=false"},
    "csr_rdata": {"type": ["integer", "null"], "note": "null iff csr_we=false and no CSR read"},
    "mem_valid": {"type": "boolean"},
    "mem_we": {"type": "boolean", "note": "false when mem_valid=false"},
    "mem_va": {"type": ["integer", "null"], "note": "null iff mem_valid=false"},
    "mem_pa": {"type": ["integer", "null"], "max": 17179869183, "note": "null iff mem_valid=false; 34-bit PA"},
    "mem_size": {"type": "string", "enum": ["none", "byte", "half", "word"]},
    "mem_mask": {"type": ["integer", "null"], "min": 0, "max": 15, "note": "null iff mem_valid=false"},
    "mem_wdata": {"type": ["integer", "null"], "note": "null for loads"},
    "mem_rdata": {"type": ["integer", "null"], "note": "null for stores"},
    "source": {"type": "string", "enum": ["dut", "spike-derived", "synthetic"]}
  },
  "trap_required": [
    "schema",
    "kind",
    "seq",
    "pc",
    "epc",
    "target_pc",
    "cause",
    "is_interrupt",
    "tval",
    "from_priv",
    "to_priv",
    "mstatus_before",
    "mstatus_after",
    "cause_csr_before",
    "cause_csr_after",
    "epc_csr_before",
    "epc_csr_after",
    "source"
  ],
  "trap_fields": {
    "kind": {"const": "trap"},
    "cause": {"type": "integer", "min": 0, "max": 31},
    "is_interrupt": {"type": "boolean"},
    "tval": {"type": "integer", "min": 0, "max": 4294967295},
    "from_priv": {"type": "string", "enum": ["U", "S", "M"]},
    "to_priv": {"type": "string", "enum": ["U", "S", "M"]},
    "mstatus_before": {"type": "integer"},
    "mstatus_after": {"type": "integer"},
    "cause_csr_before": {"type": "integer"},
    "cause_csr_after": {"type": "integer"},
    "epc_csr_before": {"type": "integer"},
    "epc_csr_after": {"type": "integer"}
  }
}
