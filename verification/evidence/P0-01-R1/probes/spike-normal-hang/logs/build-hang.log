command: timeout -k 5s 60s riscv64-unknown-elf-gcc -march=rv32i -mabi=ilp32 -mcmodel=medany -mno-relax -nostdlib -nostartfiles -ffreestanding -fno-builtin -O2 -T /workspace/hias-riscv-cpu/software/smoke/link.ld -Wl,--build-id=none -DSMOKE_HANG=1 /workspace/hias-riscv-cpu/software/smoke/start.S /workspace/hias-riscv-cpu/software/smoke/main.c -o build/ref-smoke/hang.elf
